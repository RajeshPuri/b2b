# Environment variables example file
# Copy to .env.local and fill values for development
# Never commit actual .env files to version control

# Database
DATABASE_URL="postgres://b2b_user:CHANGE_ME@localhost:5433/b2b_platform?schema=public"
DIRECT_URL="postgres://b2b_user:CHANGE_ME@localhost:5433/b2b_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth.js
SESSION_SECRET="change-this-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-long-random-string"

# S3 Storage (MinIO or AWS)
S3_BUCKET="b2b-dev-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Email (Resend or SMTP)
RESEND_API_KEY=""

# Application
POSTGRES_PASSWORD="change_me_password"
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000